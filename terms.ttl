@prefix dct: <http://purl.org/dc/terms/> .
@prefix fip: <https://w3id.org/fair/fip/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix terms: <https://w3id.org/fair-tox/terms#> .

<http://id.nlm.nih.gov/mesh/D054750> skos:exactMatch <https://doi.org/10.1351/goldbook.14399> .

<http://purl.obolibrary.org/obo/NCIT_C20179> skos:exactMatch <https://doi.org/10.1351/goldbook.16156> .

<http://semanticscience.org/resource/SIO_000619> skos:closeMatch <http://purl.obolibrary.org/obo/OBI_0000450> .

<http://www.wikidata.org/entity/Q6013136> skos:broadMatch <http://purl.obolibrary.org/obo/NCIT_C17206>,
        <https://doi.org/10.1351/goldbook.T06417> .

<https://w3id.org/fair-tox/terms> a owl:Ontology ;
    rdfs:label "Terms of the FAIR implementation ecosystem for toxicology" ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    owl:versionInfo "0.3.0" .

terms:deprecates a schema:DefinedTerm,
        skos:Concept ;
    schema:description "The subject replaces the target." ;
    schema:inDefinedTermSet terms:hadRole-values ;
    schema:name "deprecates" ;
    schema:termCode "deprecates" ;
    skos:definition "The subject replaces the target." ;
    skos:exactMatch dct:replaces ;
    skos:inScheme terms:hadRole-values ;
    skos:prefLabel "deprecates" .

terms:extends a schema:DefinedTerm,
        skos:Concept ;
    schema:description "The subject builds on and extends the target." ;
    schema:inDefinedTermSet terms:hadRole-values ;
    schema:name "extends" ;
    schema:termCode "extends" ;
    skos:broadMatch schema:isBasedOn ;
    skos:closeMatch <http://purl.org/spar/cito/extends> ;
    skos:definition "The subject builds on and extends the target." ;
    skos:inScheme terms:hadRole-values ;
    skos:prefLabel "extends" .

terms:implements a schema:DefinedTerm,
        skos:Concept ;
    schema:description "The database implements the standard." ;
    schema:inDefinedTermSet terms:hadRole-values ;
    schema:name "implements" ;
    schema:termCode "implements" ;
    skos:closeMatch dct:conformsTo,
        <http://semanticscience.org/resource/SIO_000233>,
        fip:implements ;
    skos:definition "The database implements the standard." ;
    skos:inScheme terms:hadRole-values ;
    skos:prefLabel "implements" .

terms:maintained-active a schema:DefinedTerm,
        skos:Concept ;
    schema:description "Maintained and available." ;
    schema:inDefinedTermSet terms:maintained-values ;
    schema:name "active" ;
    schema:termCode "maintained-active" ;
    skos:closeMatch <http://publications.europa.eu/resource/authority/distribution-status/ONGOING> ;
    skos:definition "Maintained and available." ;
    skos:inScheme terms:maintained-values ;
    skos:prefLabel "active" .

terms:phase-data-generation a schema:DefinedTerm,
        skos:Concept ;
    schema:description "Planning, producing and depositing primary records: datasets, protocols, method descriptions and the publications reporting them." ;
    schema:inDefinedTermSet terms:phase-values ;
    schema:name "Data generation" ;
    schema:termCode "phase-data-generation" ;
    skos:closeMatch <http://edamontology.org/topic_3077>,
        <http://purl.obolibrary.org/obo/T4FS_0000108> ;
    skos:definition "Planning, producing and depositing primary records: datasets, protocols, method descriptions and the publications reporting them." ;
    skos:inScheme terms:phase-values ;
    skos:prefLabel "Data generation" .

terms:phase-data-integration a schema:DefinedTerm,
        skos:Concept ;
    schema:description "Integrating and synthesising those records into secondary resources and evidence: curated databases, knowledge bases, ontologies, pathway networks and models." ;
    schema:inDefinedTermSet terms:phase-values ;
    schema:name "Data integration" ;
    schema:termCode "phase-data-integration" ;
    skos:closeMatch <http://edamontology.org/topic_3366>,
        <http://purl.obolibrary.org/obo/T4FS_0000487> ;
    skos:definition "Integrating and synthesising those records into secondary resources and evidence: curated databases, knowledge bases, ontologies, pathway networks and models." ;
    skos:inScheme terms:phase-values ;
    skos:prefLabel "Data integration" .

terms:phase-regulatory-assessment a schema:DefinedTerm,
        skos:Concept ;
    schema:description "Assessing records and secondary resources for reliability and relevance in a regulatory context and integrating them into weight of evidence and decisions." ;
    schema:inDefinedTermSet terms:phase-values ;
    schema:name "Regulatory assessment" ;
    schema:termCode "phase-regulatory-assessment" ;
    skos:definition "Assessing records and secondary resources for reliability and relevance in a regulatory context and integrating them into weight of evidence and decisions." ;
    skos:inScheme terms:phase-values ;
    skos:prefLabel "Regulatory assessment" ;
    skos:relatedMatch <http://edamontology.org/topic_3394>,
        <http://id.nlm.nih.gov/mesh/D018570>,
        <http://purl.obolibrary.org/obo/T4FS_0000507>,
        <https://doi.org/10.1351/goldbook.16194>,
        <https://vhp4safety.github.io/glossary#VHP0000101>,
        <https://vhp4safety.github.io/glossary#VHP0000103>,
        <https://vhp4safety.github.io/glossary#VHP0000159> .

terms:profiles a schema:DefinedTerm,
        skos:Concept ;
    schema:description "The standard is a profile of the target standard." ;
    schema:inDefinedTermSet terms:hadRole-values ;
    schema:name "profiles" ;
    schema:termCode "profiles" ;
    skos:broadMatch dct:conformsTo ;
    skos:definition "The standard is a profile of the target standard." ;
    skos:exactMatch <http://www.w3.org/ns/dx/prof/isProfileOf> ;
    skos:inScheme terms:hadRole-values ;
    skos:prefLabel "profiles" .

terms:recommends a schema:DefinedTerm,
        skos:Concept ;
    schema:description "The policy recommends the target." ;
    schema:inDefinedTermSet terms:hadRole-values ;
    schema:name "recommends" ;
    schema:termCode "recommends" ;
    skos:broadMatch dct:relation ;
    skos:definition "The policy recommends the target." ;
    skos:inScheme terms:hadRole-values ;
    skos:prefLabel "recommends" .

terms:related_to a schema:DefinedTerm,
        skos:Concept ;
    schema:description "The resources are related without one building on the other." ;
    schema:inDefinedTermSet terms:hadRole-values ;
    schema:name "related_to" ;
    schema:termCode "related_to" ;
    skos:definition "The resources are related without one building on the other." ;
    skos:exactMatch dct:relation ;
    skos:inScheme terms:hadRole-values ;
    skos:prefLabel "related_to" .

terms:subdomains-regulatory-toxicology a schema:DefinedTerm,
        skos:Concept ;
    dct:source <https://doi.org/10.1016/S0378-4274(01)00457-X> ;
    schema:description "Toxicology that collects, processes and evaluates experimental and epidemiological data as the basis for decisions that protect health from the harmful effects of chemical substances, and that develops standard protocols and new test methods for them (after Schwenk et al., 2002, doi:10.1016/S0378-4274(01)00457-X)." ;
    schema:inDefinedTermSet terms:subdomains-values ;
    schema:name "regulatory toxicology" ;
    schema:termCode "subdomains-regulatory-toxicology" ;
    skos:broadMatch <http://purl.obolibrary.org/obo/NCIT_C17206>,
        <https://doi.org/10.1351/goldbook.T06417> ;
    skos:definition "Toxicology that collects, processes and evaluates experimental and epidemiological data as the basis for decisions that protect health from the harmful effects of chemical substances, and that develops standard protocols and new test methods for them (after Schwenk et al., 2002, doi:10.1016/S0378-4274(01)00457-X)." ;
    skos:inScheme terms:subdomains-values ;
    skos:prefLabel "regulatory toxicology" ;
    skos:relatedMatch <http://www.wikidata.org/entity/Q2448782> .

terms:maintained-values a schema:DefinedTermSet,
        skos:ConceptScheme ;
    dct:conformsTo <https://w3id.org/cdif/conceptscheme/1.1> ;
    schema:name "maintained values" ;
    skos:definition "Maintenance statuses of a resource, where no outside concept exists." ;
    skos:hasTopConcept terms:maintained-active ;
    skos:prefLabel "maintained values" .

terms:subdomains-values a schema:DefinedTermSet,
        skos:ConceptScheme ;
    dct:conformsTo <https://w3id.org/cdif/conceptscheme/1.1> ;
    schema:name "subdomains values" ;
    skos:definition "Toxicology sub-domains that a resource serves, where no outside concept exists." ;
    skos:hasTopConcept terms:subdomains-regulatory-toxicology ;
    skos:prefLabel "subdomains values" .

terms:phase-values a schema:DefinedTermSet,
        skos:ConceptScheme ;
    dct:conformsTo <https://w3id.org/cdif/conceptscheme/1.1> ;
    schema:name "phase values" ;
    skos:definition "Data life-cycle phases that a toxicology resource acts on." ;
    skos:hasTopConcept terms:phase-data-generation,
        terms:phase-data-integration,
        terms:phase-regulatory-assessment ;
    skos:prefLabel "phase values" .

terms:hadRole-values a schema:DefinedTermSet,
        skos:ConceptScheme ;
    dct:conformsTo <https://w3id.org/cdif/conceptscheme/1.1> ;
    schema:name "hadRole values" ;
    skos:definition "FAIRsharing's labels for relations between records, read subject first." ;
    skos:hasTopConcept terms:deprecates,
        terms:extends,
        terms:implements,
        terms:profiles,
        terms:recommends,
        terms:related_to ;
    skos:prefLabel "hadRole values" .

