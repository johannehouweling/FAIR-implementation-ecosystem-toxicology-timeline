   "skos:definition": "Integration and tools.",
   "skos:inScheme": {
    "@id": "terms:subdomains-values"
   },
   "skos:prefLabel": "computational and predictive toxicology"
  },
  {
   "@id": "terms:subdomains-eco-toxicology",
   "@type": "skos:Concept",
   "skos:definition": "Data generation.",
   "skos:inScheme": {
    "@id": "terms:subdomains-values"
   },
   "skos:prefLabel": "eco-toxicology"
  },
  {
   "@id": "terms:subdomains-exposome",
