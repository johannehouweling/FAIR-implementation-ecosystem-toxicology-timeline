  {
   "@id": "https://doi.org/10.25504/FAIRsharing.ewjdq6",
   "identifier": "https://doi.org/10.25504/FAIRsharing.ewjdq6",
   "schemaType": "schema:CreativeWork",
   "key": "biosd",
   "name": "BioSamples",
   "alternateName": [
    "BioSD"
   ],
   "fairsharingType": "Database: repository",
   "fsrType": [
    "https://w3id.org/fair/fip/terms/Domain-Specific-Registry"
   ],
   "origin": "Life Sciences",
   "subdomains": [
    "toxicogenomics"
