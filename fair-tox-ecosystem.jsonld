   "name": "Cell Line Ontology",
   "fairsharingType": "Standard: terminology artefact",
   "fsrType": [
    "https://w3id.org/fair/fip/terms/Semantic-model",
    "https://w3id.org/fair/fip/terms/Structured-vocabulary"
