  {
   "@id": "https://doi.org/10.25504/FAIRsharing.mtjvme",
   "identifier": "https://doi.org/10.25504/FAIRsharing.mtjvme",
   "schemaType": "schema:CreativeWork",
   "key": "biostudies",
   "name": "BioStudies",
   "alternateName": [
    "BioStudies repository"
   ],
   "fairsharingType": "Database: repository",
   "fsrType": [
    "https://w3id.org/fair/fip/terms/Identifier-service",
    "https://w3id.org/fair/fip/terms/Registry"
   ],
   "origin": "Life Sciences",
   "subdomains": [
    "conventional toxicology",
    "toxicogenomics"
   ],
   "datePublished": "2015-12-23",
   "dateSource": "https://doi.org/10.15252/msb.20156658",
   "creator": "https://ror.org/02catss52",
   "url": "https://www.ebi.ac.uk/biostudies/",
   "description": "An EMBL-EBI archive for whole biological studies. It stores study-level metadata, links to data held in other archives, and data files that have no dedicated repository. It hosts project collections, including those of toxicology projects, and now holds the ArrayExpress functional genomics data.",
   "maintained": "active",
   "fairsharingRecord": {
    "@id": "https://fairsharing.org/FAIRsharing.mtjvme",
