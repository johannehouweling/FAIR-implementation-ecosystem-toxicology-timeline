 "@id": "",
 "@type": "schema:Dataset",
 "name": "FAIR implementation ecosystem for toxicology",
 "description": "FAIR-enabling resources used in toxicology (standards, databases, policies and tools), curated by the ELIXIR Toxicology Community together with the FAIRsharing Toxicology collection, with first publication dates, FAIRsharing types, lifecycle phases, sub-domains and relations.",
 "version": "0.1.0",
 "dateModified": "2026-10-05",
 "license": "https://creativecommons.org/licenses/by-sa/4.0/",
 "creator": "ELIXIR Toxicology Community",
